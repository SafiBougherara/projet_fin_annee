@startuml MCD_CALENDRIA
' =====================================================================
'  CALENDRIA - Modele Conceptuel de Donnees (MCD)
'  Formalisme MERISE - Entite / Association
'
'  Regles respectees a ce niveau :
'   - on parle d'ENTITES et de PROPRIETES, jamais de tables ni de colonnes
'   - l'identifiant est souligne ; aucune cle primaire ni cle etrangere
'     n'apparait : les cles sont introduites au niveau LOGIQUE (MLD)
'   - les associations sont representees par des OVALES portant un verbe
'   - les cardinalites (min,max) sont portees par chaque patte,
'     du cote de l'entite concernee
' =====================================================================

title CALENDRIA - Modele Conceptuel de Donnees (MERISE)

' necessaire pour melanger entites (rectangles) et associations (ovales)
allowmixing

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 75
skinparam ranksep 70

hide circle
hide methods
skinparam classAttributeIconSize 0

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 1.2
}
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
  BorderThickness 1.2
}

' ─────────────────────────────────────────────
'  ENTITES  (identifiant souligne, puis proprietes)
' ─────────────────────────────────────────────

entity RESTAURANT {
  __id_restaurant__
  ..
  nom
  adresse
  telephone
  email
  capacite_totale
  duree_repas
  buffer_nettoyage
  date_creation
}

entity UTILISATEUR {
  __id_utilisateur__
  ..
  email
  mot_de_passe
  roles
}

entity TABLE_RESTAURANT {
  __id_table__
  ..
  numero_table
  capacite
  type
  statut
}

entity SERVICE {
  __id_service__
  ..
  type
  heure_debut
  heure_fin
  jours_ouverture
}

entity FERMETURE_EXCEPTIONNELLE {
  __id_fermeture__
  ..
  date_fermeture
  motif
}

entity CLIENT {
  __id_client__
  ..
  nom
  telephone
  email
  preferences
  consentement_rgpd
  taux_noshow
}

entity RESERVATION {
  __id_reservation__
  ..
  date_reservation
  heure_reservation
  nombre_personnes
  statut
  demandes_speciales
}

entity CONVERSATION_IA {
  __id_conversation__
  ..
  telephone_appelant
  canal
  date_debut
  date_fin
  transcription
  donnees_collectees
  statut
}

entity NOTIFICATION {
  __id_notification__
  ..
  destinataire
  message
  type
  canal
  statut_envoi
  date_envoi
}

' ─────────────────────────────────────────────
'  ASSOCIATIONS  (ovales portant un verbe)
' ─────────────────────────────────────────────

usecase "POSSEDER" as A_POSSEDER
usecase "DEFINIR" as A_DEFINIR
usecase "PLANIFIER" as A_PLANIFIER
usecase "EMPLOYER" as A_EMPLOYER
usecase "RECEVOIR" as A_RECEVOIR
usecase "EFFECTUER" as A_EFFECTUER
usecase "ATTRIBUER" as A_ATTRIBUER
usecase "GENERER" as A_GENERER
usecase "PARTICIPER" as A_PARTICIPER
usecase "CONCERNER" as A_CONCERNER
usecase "ABOUTIR" as A_ABOUTIR

' ─────────────────────────────────────────────
'  PATTES ET CARDINALITES  (min,max)
' ─────────────────────────────────────────────

RESTAURANT "1,N" -- A_POSSEDER
A_POSSEDER -- "1,1" TABLE_RESTAURANT

RESTAURANT "1,N" -- A_DEFINIR
A_DEFINIR -- "1,1" SERVICE

RESTAURANT "0,N" -- A_PLANIFIER
A_PLANIFIER -- "1,1" FERMETURE_EXCEPTIONNELLE

RESTAURANT "0,N" -- A_EMPLOYER
A_EMPLOYER -- "0,1" UTILISATEUR

RESTAURANT "0,N" -- A_RECEVOIR
A_RECEVOIR -- "1,1" RESERVATION

CLIENT "0,N" -- A_EFFECTUER
A_EFFECTUER -- "1,1" RESERVATION

TABLE_RESTAURANT "0,N" -- A_ATTRIBUER
A_ATTRIBUER -- "0,1" RESERVATION

RESERVATION "0,N" -- A_GENERER
A_GENERER -- "1,1" NOTIFICATION

CLIENT "0,N" -- A_PARTICIPER
A_PARTICIPER -- "0,1" CONVERSATION_IA

RESTAURANT "0,N" -- A_CONCERNER
A_CONCERNER -- "1,1" CONVERSATION_IA

CONVERSATION_IA "0,1" -- A_ABOUTIR
A_ABOUTIR -- "0,1" RESERVATION

' ─────────────────────────────────────────────
'  LEGENDE
' ─────────────────────────────────────────────

legend bottom
  Formalisme MERISE - niveau CONCEPTUEL
  ====
  Rectangle = ENTITE (proprietes ; identifiant souligne)
  Ovale = ASSOCIATION (verbe reliant les entites)
  ----
  Cardinalites lues du cote de l'entite :
  1,1 = une et une seule occurrence
  0,1 = au plus une occurrence
  1,N = au moins une occurrence
  0,N = zero ou plusieurs occurrences
  ----
  Aucune cle primaire ni etrangere a ce niveau : elles apparaissent au MLD.
endlegend

note bottom of CLIENT
  CLIENT n'est rattache a aucun RESTAURANT :
  le MVP est mono-etablissement. En multi-restaurant,
  il faudrait ajouter une association CLIENT-RESTAURANT
  (ou une classe d'association) pour porter le consentement
  RGPD et le taux de no-show par etablissement.
end note

note bottom of CONVERSATION_IA
  La conversation demarre avant l'identification de
  l'appelant : la patte cote CLIENT est donc 0,1.
  L'association CONCERNER permet au webhook de savoir
  pour quel etablissement le chatbot repond.
end note

@enduml
