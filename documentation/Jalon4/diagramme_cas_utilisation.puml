@startuml UC_CALENDRIA
' =====================================================================
'  CALENDRIA - Diagramme des cas d'utilisation (UML)
'
'  Regles UML respectees :
'   - association acteur / cas d'utilisation = TRAIT SIMPLE, sans fleche
'     (la fleche ne servirait qu'a indiquer une navigabilite, inutile ici)
'   - <<include>> : le cas de BASE inclut TOUJOURS le cas inclus
'       => fleche pointillee du cas de BASE vers le cas INCLUS
'   - <<extend>> : le cas d'EXTENSION complete optionnellement un cas de base
'       => fleche pointillee du cas d'EXTENSION vers le cas de BASE
'         (sens inverse de include : c'est l'erreur corrigee ici)
'   - seules les fonctionnalites REELLEMENT LIVREES figurent au diagramme
' =====================================================================

title CALENDRIA - Diagramme des cas d'utilisation

left to right direction

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam actorFontSize 13
skinparam usecaseFontSize 12
skinparam packageFontSize 13
skinparam nodesep 25
skinparam ranksep 55

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #000000
}

' ─────────────────────────────────────────────
'  ACTEURS
' ─────────────────────────────────────────────

actor "Client" as client
actor "Restaurateur" as restaurateur
actor :Assistant IA: as ia <<system>>

' ─────────────────────────────────────────────
'  SOUS-SYSTEME : RESERVATION MULTI-CANAL
' ─────────────────────────────────────────────

rectangle "Reservation multi-canal" {
  usecase "UC1 - Converser avec\nl'assistant de reservation" as UC1
  usecase "UC2 - Creer une reservation" as UC2
  usecase "UC3 - Consulter les\ncreneaux disponibles" as UC3
  usecase "UC4 - Se voir proposer\ndes creneaux alternatifs" as UC4
  usecase "UC5 - Attribuer une table\nautomatiquement" as UC5
}

' ─────────────────────────────────────────────
'  SOUS-SYSTEME : DASHBOARD RESTAURATEUR
' ─────────────────────────────────────────────

rectangle "Dashboard restaurateur" {
  usecase "UC6 - S'authentifier (JWT)" as UC6
  usecase "UC7 - Consulter le\ntableau de bord" as UC7
  usecase "UC8 - Gerer les reservations\n(creer, modifier, annuler)" as UC8
  usecase "UC9 - Consulter le\nplan de salle" as UC9
  usecase "UC10 - Configurer services\net horaires" as UC10
  usecase "UC11 - Gerer les tables\net le restaurant" as UC11
}

' ─────────────────────────────────────────────
'  ASSOCIATIONS ACTEUR <-> CAS  (traits simples)
' ─────────────────────────────────────────────

client -- UC1
client -- UC2
client -- UC3

restaurateur -- UC6
restaurateur -- UC7
restaurateur -- UC8
restaurateur -- UC9
restaurateur -- UC10
restaurateur -- UC11

ia -- UC1
ia -- UC5

' ─────────────────────────────────────────────
'  RELATIONS <<include>>  (base --> inclus)
' ─────────────────────────────────────────────

' Creer une reservation verifie TOUJOURS la disponibilite
UC2 ..> UC3 : <<include>>

' Creer une reservation attribue TOUJOURS une table
UC2 ..> UC5 : <<include>>

' Toutes les actions du dashboard exigent une authentification
UC7 ..> UC6 : <<include>>
UC8 ..> UC6 : <<include>>
UC9 ..> UC6 : <<include>>
UC10 ..> UC6 : <<include>>
UC11 ..> UC6 : <<include>>

' ─────────────────────────────────────────────
'  RELATIONS <<extend>>  (extension --> base)
' ─────────────────────────────────────────────

' Converser est une MANIERE OPTIONNELLE de creer une reservation :
' c'est UC1 qui etend UC2, la fleche part donc de UC1 vers UC2.
UC1 ..> UC2 : <<extend>>

' Proposer des alternatives n'arrive QUE si aucun creneau n'est libre :
' UC4 etend UC3.
UC4 ..> UC3 : <<extend>>

' ─────────────────────────────────────────────
'  LEGENDE
' ─────────────────────────────────────────────

legend bottom
  Acteurs
  ====
  Client : reserve via le widget web ou le bot Telegram
  Restaurateur : pilote son etablissement via le dashboard
  Assistant IA : acteur systeme (Google Gemini + algorithme d'attribution)
  ----
  Relations
  ====
  Trait simple = association acteur / cas d'utilisation
  A ..> B <<include>> : A declenche TOUJOURS B
  A ..> B <<extend>>  : A complete OPTIONNELLEMENT B (fleche vers le cas de base)
  ----
  Perimetre : seules les fonctionnalites livrees dans le MVP sont representees.
  Notifications SMS, rappels 24h et statistiques avancees ont ete ecartes du perimetre.
endlegend

@enduml
