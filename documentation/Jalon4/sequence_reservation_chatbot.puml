@startuml SEQ_Reservation_Chatbot
' =====================================================================
'  CALENDRIA - Diagramme de sequence
'  UC2 : creer une reservation via l'assistant conversationnel
'
'  Corrections apportees :
'   - CHAQUE appel a la base de donnees possede desormais sa fleche de
'     RETOUR en pointilles (le diagramme precedent n'en avait aucune)
'   - les participants correspondent au code reellement livre :
'       Google Gemini 2.5 Flash (et non OpenAI)
'       Cache Symfony pour l'etat de la conversation (et non une table)
'       aucun NotificationService ni Twilio : hors perimetre du MVP
' =====================================================================

title CALENDRIA - Diagramme de sequence\nUC2 : creer une reservation via l'assistant conversationnel

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam maxMessageSize 220

skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #000000
}
skinparam sequence {
  ArrowColor #000000
  LifeLineBorderColor #000000
  LifeLineBackgroundColor #FFFFFF
  GroupBorderColor #000000
}

' ─────────────────────────────────────────────
'  PARTICIPANTS
' ─────────────────────────────────────────────

actor "Client" as client
participant "Widget web\nou bot Telegram" as canal
participant "ChatbotController" as controller
participant "ChatbotService" as chatbot
participant "Cache Symfony" as cache
participant "API Google\nGemini 2.5 Flash" as gemini
participant "DisponibiliteService" as dispo
participant "Doctrine ORM" as orm
database "PostgreSQL" as db

' =====================================================================
'  PHASE 1 : COLLECTE CONVERSATIONNELLE
' =====================================================================

== Phase 1 : collecte conversationnelle ==

client -> canal : "Je veux une table\npour 4 demain a 20h"
activate canal

canal -> controller : POST /api/chatbot/message\n{sessionId, restaurantId, message}
activate controller

controller -> chatbot : traiterMessage(sessionId,\nrestaurantId, message)
activate chatbot

chatbot -> orm : find(restaurantId)
activate orm
orm -> db : SELECT * FROM restaurant\nWHERE id = :id
activate db
db --> orm : 1 enregistrement
deactivate db
orm --> chatbot : Restaurant
deactivate orm

chatbot -> cache : get(sessionId)
activate cache
cache --> chatbot : historique + donnees\ndeja collectees
deactivate cache

chatbot -> gemini : POST generateContent\n(prompt + historique)
activate gemini
gemini --> chatbot : { intention, date, heure,\nnb_personnes, nom, telephone }
deactivate gemini

alt Informations incompletes
  chatbot -> cache : set(sessionId, donnees partielles)
  activate cache
  cache --> chatbot : ok
  deactivate cache
  chatbot --> controller : question suivante\n("A quel nom ?")
  controller --> canal : 200 OK { response }
  canal --> client : affichage de la question
end

' =====================================================================
'  PHASE 2 : VERIFICATION DE DISPONIBILITE
' =====================================================================

== Phase 2 : verification de disponibilite ==

chatbot -> dispo : verifierDisponibilite(restaurantId,\ndate, heure, nbPersonnes)
activate dispo

dispo -> orm : findBy(restaurant, date)
activate orm
orm -> db : SELECT * FROM reservation\nWHERE restaurant_id = :r AND date = :d
activate db
db --> orm : reservations du jour
deactivate db
orm --> dispo : Collection<Reservation>
deactivate orm

dispo -> dispo : tri des tables par capacite\ncroissante puis test de\nchevauchement des creneaux

dispo --> chatbot : { disponible, table, alternatives }
deactivate dispo

' =====================================================================
'  PHASE 3 : PERSISTANCE OU REPLI
' =====================================================================

== Phase 3 : persistance ou repli ==

alt Une table est disponible

  chatbot -> orm : findOneBy(telephone)
  activate orm
  orm -> db : SELECT * FROM client\nWHERE telephone = :tel
  activate db
  db --> orm : 0 ou 1 enregistrement
  deactivate db
  orm --> chatbot : Client ou null
  deactivate orm

  chatbot -> orm : persist(Client si nouveau)\npersist(Reservation)\nflush()
  activate orm
  orm -> db : INSERT INTO client (...)\nINSERT INTO reservation (statut = 'confirmee')
  activate db
  db --> orm : identifiants generes\n(COMMIT)
  deactivate db
  orm --> chatbot : Reservation persistee
  deactivate orm

  chatbot -> cache : delete(sessionId)
  activate cache
  cache --> chatbot : session reinitialisee
  deactivate cache

  chatbot --> controller : { response : "Reservation confirmee",\nbooked : true }
  controller --> canal : 200 OK
  canal --> client : confirmation immediate

else Aucune table disponible

  chatbot --> controller : { response : "Complet a 20h,\nje peux vous proposer 20h30 ou 21h",\nbooked : false }
  controller --> canal : 200 OK
  canal --> client : creneaux alternatifs

end

deactivate chatbot
deactivate controller
deactivate canal

legend bottom
  Lecture des fleches
  ====
  Trait plein : appel (message synchrone)
  Trait pointille : reponse retournee a l'appelant
  ----
  Chaque acces a PostgreSQL est represente par un couple
  appel / reponse : le diagramme precedent omettait les retours
  de la base, ce qui laissait croire a des ecritures sans confirmation.
endlegend

@enduml
